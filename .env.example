# ==============================================================================
# Cloud Management Platform (CMP) - Root Environment Configuration Example
# ==============================================================================
# Copy this file to .env for shared or orchestration configurations.
# NOTE: Each service also contains its own specific .env.example file.
# Never commit real secrets or credentials to source control.
# ==============================================================================

# Global Environment Mode: development | staging | production
APP_ENV=development
APP_NAME="Cloud Management Platform"

# Service Ports (Local Development Defaults)
FRONTEND_PORT=3000
BACKEND_PORT=8000
GO_SERVICE_PORT=8080
PHP_SERVICE_PORT=8001

# PostgreSQL Configuration (Local Development on macOS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cmp_core_db
DB_USER=cmp_user
DB_PASSWORD=replace_with_secure_password
DB_CONNECTION_MAX_AGE=600

# Base URLs for Internal Communication
DJANGO_API_BASE_URL=http://localhost:8000/api/v1
GO_SERVICE_BASE_URL=http://localhost:8080
PHP_SERVICE_BASE_URL=http://localhost:8001

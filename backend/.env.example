# ==============================================================================
# Core Backend Service - Environment Variables
# Tech Stack: Python 3.12+ / Django REST Framework / PostgreSQL
# ==============================================================================

# General Django Configuration
DJANGO_SECRET_KEY=replace_with_django_secret_key_in_production
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
BACKEND_PORT=8000

# PostgreSQL Database Configuration (Local macOS Development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cmp_core_db
DB_USER=cmp_user
DB_PASSWORD=replace_with_secure_password
DB_CONNECTION_MAX_AGE=600

# CORS Configuration (Next.js Frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Internal Service Authentication (For Go and PHP Service HTTP APIs)
INTERNAL_SERVICE_API_KEY=replace_with_internal_service_api_key

# Pagination and Rate Limiting
DEFAULT_PAGE_SIZE=25
REST_FRAMEWORK_THROTTLE_RATE_ANON=100/day
REST_FRAMEWORK_THROTTLE_RATE_USER=1000/day

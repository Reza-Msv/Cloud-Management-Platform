# ==============================================================================
# Cloud Management Platform — Frontend Environment Configuration
# Tech Stack: Next.js 16.4.6 (App Router) / React 19 / TypeScript / Tailwind CSS
# ==============================================================================

# Next.js Server Port & Node Environment
PORT=3000
NODE_ENV=development

# Application Site & Branding
NEXT_PUBLIC_APP_NAME="Cloud Management Platform"
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API Endpoints
# Primary Django REST API v1 Base URL used by all frontend queries and mutations
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Additional Microservice Endpoints (Reserved for multi-service integration)
NEXT_PUBLIC_DJANGO_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_GO_SERVICE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_PHP_SERVICE_URL=http://localhost:8001/api/v1

# Server-Side Internal Microservice URLs (Proxy Route Handlers)
GO_SERVICE_BASE_URL=http://localhost:8080

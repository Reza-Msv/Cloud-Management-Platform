# ==============================================================================
# Frontend Service - Environment Variables
# Tech Stack: Next.js (App Router) / TypeScript / Tailwind CSS
# ==============================================================================

# Next.js Server Port
PORT=3000
NODE_ENV=development

# Application Metadata
NEXT_PUBLIC_APP_NAME="Cloud Management Platform"

# Backend API Endpoints
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DJANGO_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_GO_SERVICE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_PHP_SERVICE_URL=http://localhost:8001/api/v1

# Authentication & Session (NextAuth / JWT Session Management)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_a_secure_session_secret

# ==============================================================================
# Independent Go Service - Environment Variables
# Tech Stack: Go (Golang) / HTTP REST / High-Concurrency Workers
# ==============================================================================

# Server Configuration
GO_PORT=8080
ENVIRONMENT=development
LOG_LEVEL=debug

# Core Backend (Django REST Framework) API Configuration
# All business logic and persistence must be routed through this endpoint.
DJANGO_API_BASE_URL=http://localhost:8000/api/v1
DJANGO_API_TIMEOUT_SECONDS=15

# Inter-Service Authentication
INTERNAL_SERVICE_API_KEY=replace_with_internal_service_api_key

# Worker & Telemetry Settings
METRICS_COLLECTION_INTERVAL_SECONDS=30
WORKER_POOL_SIZE=10

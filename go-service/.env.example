# ==============================================================================
# Independent Go Service - Environment Variables
# Tech Stack: Go (Golang) / HTTP REST
# ==============================================================================

# Server Configuration
HTTP_PORT=8080
APP_ENV=development
APP_VERSION=1.0.0

# Core Backend (Django REST Framework) API Configuration
# All business logic and persistence must be routed through this endpoint.
DJANGO_API_BASE_URL=http://localhost:8000/api/v1
DJANGO_API_TIMEOUT=5s

# Service-to-Service Authentication
# Django services endpoint supports BasicAuthentication.
# Configure service account credentials with Admin or Operator permissions:
DJANGO_AUTH_USERNAME=admin_user
DJANGO_AUTH_PASSWORD=SecretPassword123!

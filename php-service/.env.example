# ==============================================================================
# Additional PHP Service - Environment Variables
# Tech Stack: PHP 8.2+ / Laravel / HTTP REST Client
# ==============================================================================

# Laravel Application Settings
APP_NAME="CMP PHP Service"
APP_ENV=local
APP_KEY=base64:placeholder_run_artisan_key_generate_in_phase_5
APP_DEBUG=true
APP_URL=http://localhost:8001
PHP_PORT=8001

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Core Backend (Django REST Framework) API Configuration
# This service interacts with the system solely via Django REST APIs.
DJANGO_API_BASE_URL=http://localhost:8000/api/v1
DJANGO_API_TIMEOUT=15

# Inter-Service Authentication
INTERNAL_SERVICE_API_KEY=replace_with_internal_service_api_key
